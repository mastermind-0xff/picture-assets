{
  "name": "image-resize",
  "version": "0.0.1",
  "description": "Basic react elements",
  "scripts": {
    "/** [ Cleanup commands ]==================================== */": "exit 0",
    "clean:dist": "rimraf --glob dist/*",
    "clean:docs": "rimraf --glob docs/*",
    "clean:bundle": "npm run clean:dist && npm run clean:docs",
    "clean:output.tests": "rimraf --glob __tests__/e2e/assets/optimized-images/*",
    "/** [ Build commands ]====================================== */": "exit 0",
    "lint": "eslint . && prettier . --check",
    "lint:debug:commit-ok": "git status | grep -q 'nothing to commit",
    "lint:debug:diff-stash-drop": "git diff && git stash && git stash drop",
    "lint:debug:prettier": "prettier . --write && npm run lint:debug:diff-stash-drop",
    "lint:debug": "npm run lint:debug:commit-ok && (npm run lint:debug:prettier || echo 'Debug filed') || echo 'Please commit before debug'",
    "format": "eslint . --fix && prettier . --write",
    "build:docs": "typedoc",
    "build:types": "tsc  --declaration --emitDeclarationOnly --declarationDir dist/types",
    "build:rollup": "rollup -c",
    "build:bundle": "npm run build:rollup && npm run build:types && npm run build:docs",
    "build:clean-bundle": "npm run clean:bundle && npm run build:bundle",
    "build:complete": "npm run format && npm run build:clean-bundle",
    "/** [ Test commands ]======================================= */": "exit 0",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest __tests__",
    "test:specs": "jest src"
  },
  "keywords": [],
  "author": "Tihomir Trifonov aka Mastermind",
  "license": "ISC",
  "devDependencies": {
    "@mmtypes/common": "^0.0.1",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "color-convert": "^2.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^6.6.0",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.10",
    "rollup": "^4.52.0",
    "rollup-plugin-dts": "^6.2.3",
    "ts-jest": "^29.4.4",
    "tsx": "^4.20.5",
    "typedoc": "^0.25.13",
    "typedoc-plugin-markdown": "^3.17.1",
    "typescript": "^5.4.5"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "files": [
    "./dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js",
    "default": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts"
  },
  "dependencies": {
    "@mmutils/assert": "^0.0.6",
    "@mmutils/common": "^0.0.1",
    "help": "^3.0.2",
    "sharp": "^0.34.4",
    "style-escape-codes": "^1.1.0"
  }
}
