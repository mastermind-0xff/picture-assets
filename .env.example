# Defaults for options not given in the call. Load with: node --env-file=.env
# Invalid values throw, naming the variable. Values with braces or quotes are
# in single quotes, so they read the same in a shell (set -a; . ./.env).

# 'silent', 'fatal', 'error', 'warning', 'info' (default), 'debug', 'trace' or 'verbose'
PICTURE_ASSETS_LOG_LEVEL=info

# Suffix of settings without their own. Wildcards: {w} {h} width and height
# in pixels, {x} the multiplier ('@{x}x' gives @2x), {wx} {hx} those of the
# width and of the height
PICTURE_ASSETS_SUFFIX='@{w}w'

# What x1 is: 'downsample' (default: the smallest width in pixels, else the
# source is the largest multiplier), 'upsample' (the source is x1), a
# multiplier like 'x2' (the source is x2), or the size of x1 as JSON:
# '{"width":1024,"height":768}'
PICTURE_ASSETS_RESIZE_STRATEGY_HINT=downsample

# 'none' (default), 'source' or 'batch'
PICTURE_ASSETS_ABORT_SCOPE=none

# Options per format as JSON, merged over the defaults
PICTURE_ASSETS_FORMAT_OPTIONS='{"webp":{"quality":80},"avif":{"quality":60}}'

# Sources a batch processes at a time: 'auto' (default, the libuv thread
# pool size), 'max' (the machine's parallelism) or a number
PICTURE_ASSETS_CONCURRENCY=auto

# Most pixels a source may have (width x height), or false for no limit.
# Default: 268402689 (16383 x 16383)
PICTURE_ASSETS_LIMIT_INPUT_PIXELS=268402689
