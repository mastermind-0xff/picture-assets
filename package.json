{
  "name": "picture-assets",
  "version": "0.0.1",
  "description": "Turns source images into web-ready assets: every resolution (pixels or x2-style multipliers) and format you need, from a single image or a whole directory tree, with high quality, low weight defaults.",
  "keywords": [
    "image",
    "resize",
    "responsive",
    "srcset",
    "avif",
    "webp",
    "sharp",
    "assets",
    "cli",
    "mmutils"
  ],
  "author": "Tihomir Trifonov",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "picture-assets": "dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "build": "npm run clean && rollup -c && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "examples": "npm run build && node examples/run-all.js",
    "bench": "npm run build && node bench/pipeline.js"
  },
  "dependencies": {
    "@mmutils/common": "^0.0.2",
    "@mmutils/logger": "^0.1.1",
    "@mmutils/time": "^0.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mmutils/bench": "^0.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
