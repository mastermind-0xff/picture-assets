{
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "prettier"
  ],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".ts"]
      }
    }
  },
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "root": true,
  "ignorePatterns": [
    ".git/**/*",
    "dist/**/*",
    "docs/**/*",
    "node_modules/**/*"
  ],
  "rules": {
    "no-constant-condition": ["error", { "checkLoops": false }]
  }
}
